parameters:
  level: 5
  paths:
    - bin/
    - config/
    - src/
    - tests/
  excludePaths:
    - config/reference.php (?)
  ignoreErrors:
    # Needed for older Symfony versions; newer versions no longer report this error
    -
      message: '#Method Svc\\UtilBundle\\Tests\\SvcUtilTestingKernel::configureRoutes\(\) is unused.#'
      reportUnmatched: false
